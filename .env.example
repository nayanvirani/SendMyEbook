APP_NAME=SendMyEbook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Railway PostgreSQL. Locally these are only reachable when tunneled via
# `railway connect postgres --tunnel-only`; in production Railway injects
# them automatically when these are set to service variable references
# (${{Postgres.PGHOST}}, etc.) on the app service.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=railway
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Digital files live on a Railway Storage Bucket (S3-compatible), not AWS.
FILESYSTEM_DISK=railway
DIGITAL_FILES_DISK=railway

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Railway Redis. predis is used instead of the phpredis extension.
REDIS_CLIENT=predis
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_orders,read_returns
SHOPIFY_APP_URL=http://localhost:8000

# --- Railway Storage Bucket (S3-compatible; not AWS) ---
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_USE_PATH_STYLE=false

VITE_APP_NAME="${APP_NAME}"
